# TripoNext Application Environment Configuration

# Server Port
PORT=3001

# Firebase Cloud Firestore Database Configuration
# Method A: Place downloaded serviceAccountKey.json in the project root.
# Method B: Or set the environment variables below:
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
# Optional custom path to service account JSON (defaults to ./serviceAccountKey.json)
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json


# Primary JWT Session Secret
SECRET_KEY=super_secret_travel_buddy_key

# Dedicated Server-Side Key for AES-256-GCM Encryption of TOTP Secrets at Rest
# If omitted, key is securely derived via SHA-256 from SECRET_KEY
MFA_ENCRYPTION_KEY=triponext_production_mfa_encryption_key_2026_change_in_prod

# Google Gemini AI API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: SMTP Email Service Configuration (for Email OTP verification)
# If not configured, Email OTP generates securely and logs to console in development mode.
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@yourdomain.com
SMTP_PASS=your_smtp_password
SMTP_FROM=security@triponext.com

# Optional: SMS OTP Service Configuration (Twilio / AWS SNS)
# If not configured, SMS OTP is safely reported as unconfigured without pretending.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
