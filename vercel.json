{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/server.js"
    },
    {
      "src": "^/?$",
      "dest": "/public/index.html"
    },
    {
      "src": "^/index(\\.html)?$",
      "dest": "/public/index.html"
    },
    {
      "src": "^/explore(\\.html)?/?$",
      "dest": "/public/explore.html"
    },
    {
      "src": "^/mytrips(\\.html)?/?$",
      "dest": "/public/mytrips.html"
    },
    {
      "src": "^/buddies(\\.html)?/?$",
      "dest": "/public/buddies.html"
    },
    {
      "src": "^/community(\\.html)?/?$",
      "dest": "/public/community.html"
    },
    {
      "src": "^/login(\\.html)?/?$",
      "dest": "/public/login.html"
    },
    {
      "src": "^/public/(.*)",
      "dest": "/public/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1"
    }
  ]
}
